<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/roastFragment">

    <fragment
        android:id="@+id/roastFragment"
        android:name="com.roastcompanion.ui.roast.RoastFragment"
        android:label="Roast"
        tools:layout="@layout/fragment_roast" />

    <fragment
        android:id="@+id/roastLogFragment"
        android:name="com.roastcompanion.ui.log.RoastLogFragment"
        android:label="History"
        tools:layout="@layout/fragment_roast_log">
        <action
            android:id="@+id/action_log_to_detail"
            app:destination="@id/sessionDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/sessionDetailFragment"
        android:name="com.roastcompanion.ui.log.SessionDetailFragment"
        android:label="Session Detail"
        tools:layout="@layout/fragment_session_detail">
        <argument
            android:name="sessionId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.roastcompanion.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/guideFragment"
        android:name="com.roastcompanion.ui.guide.GuideFragment"
        android:label="Roasting 101"
        tools:layout="@layout/fragment_guide" />

    <dialog
        android:id="@+id/carryoverFragment"
        android:name="com.roastcompanion.ui.roast.CarryoverFragment"
        android:label="Carryover"
        tools:layout="@layout/fragment_carryover" />

</navigation>
