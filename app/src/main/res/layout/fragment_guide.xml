<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lab_background"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:paddingBottom="88dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="24dp">

        <!-- ── Header ───────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:padding="8dp"
                android:background="@drawable/bg_phase_pill"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Roasting 101"
                    android:textColor="@color/lab_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GENE CAFE CBR-101"
                    android:textColor="@color/lab_text_dim"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Quick Start ──────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK START"
            android:textColor="@color/lab_text_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Step 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:text="1"
                    android:gravity="center"
                    android:textColor="@color/lab_amber"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_phase_pill" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Warm up to 180°C"
                        android:textColor="@color/lab_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Run the CBR-101 empty until it reaches 180°C. A warm chamber gives an even roast from the first minute."
                        android:textColor="@color/lab_text_muted"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/lab_border" android:layout_marginVertical="12dp" />

            <!-- Step 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:text="2"
                    android:gravity="center"
                    android:textColor="@color/lab_amber"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_phase_pill" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add beans, set 250°C"
                        android:textColor="@color/lab_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Load your green beans, set max temp to 250°C, and tap Start Roast in the app so the timer and mic are running."
                        android:textColor="@color/lab_text_muted"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/lab_border" android:layout_marginVertical="12dp" />

            <!-- Step 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:text="3"
                    android:gravity="center"
                    android:textColor="@color/lab_amber"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_phase_pill" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Listen for first crack"
                        android:textColor="@color/lab_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Around 7–9 minutes the beans start popping like popcorn — that's first crack. The app detects it and logs the time."
                        android:textColor="@color/lab_text_muted"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/lab_border" android:layout_marginVertical="12dp" />

            <!-- Step 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:text="4"
                    android:gravity="center"
                    android:textColor="@color/lab_amber"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_phase_pill" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cool at your target level"
                        android:textColor="@color/lab_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pick your drop point from the levels below, hit cool on the machine and Start Cooling in the app. The beans keep developing ~45s into the cool cycle — the app counts that carryover for you."
                        android:textColor="@color/lab_text_muted"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Roast levels ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROAST LEVELS"
            android:textColor="@color/lab_text_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_marginBottom="8dp" />

        <!-- Light -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="#C8A165"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Light · City"
                        android:textColor="@color/lab_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DROP AS FC ENDS"
                        android:textColor="#C8A165"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:background="@drawable/bg_tag_fc"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start cooling just as first crack finishes. Bright, acidic, tea-like — shows off the bean's origin character. Surface is dry, light brown."
                    android:textColor="@color/lab_text_muted"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Medium -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/lab_amber"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Medium · Full City"
                        android:textColor="@color/lab_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FC END + 1–2 MIN"
                        android:textColor="@color/lab_amber"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:background="@drawable/bg_tag_fc"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Continue 1–2 minutes after first crack ends, stopping before second crack. Balanced sweetness and body — the safe, crowd-pleasing default."
                    android:textColor="@color/lab_text_muted"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dark -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_surface"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/lab_red"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dark · Vienna / French"
                        android:textColor="@color/lab_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AT SECOND CRACK"
                        android:textColor="@color/lab_red"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:background="@drawable/bg_tag_sc"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Drop at the first snaps of second crack (Vienna) or 30–60s into it (French). Bold, smoky, oils on the surface. The app alarms at second crack — don't walk away, things move fast from here."
                    android:textColor="@color/lab_text_muted"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Tips ─────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIPS"
            android:textColor="@color/lab_text_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Put the phone close to the roaster, but away from the hot air exhaust.\n\n• First crack sounds like popcorn; second crack is quieter and snappier, like Rice Krispies.\n\n• The CBR-101 keeps cooking the beans for ~45 seconds after you hit cool — if you want Full City, start cooling slightly before the colour looks right.\n\n• Beans need 12–24 hours of rest after roasting before they taste their best, and 5–7 days for peak espresso."
                android:textColor="@color/lab_text_muted"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
