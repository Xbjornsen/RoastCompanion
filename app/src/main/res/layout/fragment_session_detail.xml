<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lab_background"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:paddingBottom="88dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="24dp">

        <!-- ── Header: back + title ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:padding="8dp"
                android:background="@drawable/bg_phase_pill"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/session_detail"
                    android:textColor="@color/lab_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_session_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/lab_text_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Roast name card ──────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAME"
                android:textColor="@color/lab_text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/et_roast_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Ethiopia Natural — light"
                android:textColor="@color/lab_text"
                android:textColorHint="@color/lab_text_dim"
                android:textSize="14sp"
                android:background="@drawable/bg_search"
                android:padding="12dp"
                android:inputType="textCapWords"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:singleLine="true" />
        </LinearLayout>

        <!-- ── Timeline card ─────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIMELINE"
                android:textColor="@color/lab_text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:layout_marginBottom="12dp" />

            <TextView android:id="@+id/tv_start" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/lab_text" android:textSize="13sp" android:fontFamily="monospace" />

            <!-- Charge temp: drum temp when beans are loaded -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Charge"
                    android:textColor="@color/lab_text" android:textSize="13sp" android:fontFamily="monospace" />
                <EditText android:id="@+id/et_charge_temp" android:layout_width="80dp" android:layout_height="wrap_content"
                    android:hint="—°C" android:textColor="@color/lab_text" android:textColorHint="@color/lab_text_dim"
                    android:textSize="12sp" android:fontFamily="monospace" android:gravity="end"
                    android:inputType="numberDecimal" android:background="@null" android:importantForAutofill="no"
                    android:imeOptions="actionDone" android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- FC Start row with temp field -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                <TextView android:id="@+id/tv_fc_start" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/lab_text" android:textSize="13sp" android:fontFamily="monospace" />
                <EditText android:id="@+id/et_fc_start_temp" android:layout_width="80dp" android:layout_height="wrap_content"
                    android:hint="—°C" android:textColor="@color/lab_text" android:textColorHint="@color/lab_text_dim"
                    android:textSize="12sp" android:fontFamily="monospace" android:gravity="end"
                    android:inputType="numberDecimal" android:background="@null" android:importantForAutofill="no"
                    android:imeOptions="actionDone" android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- FC End row with temp field -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                <TextView android:id="@+id/tv_fc_end" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/lab_text" android:textSize="13sp" android:fontFamily="monospace" />
                <EditText android:id="@+id/et_fc_end_temp" android:layout_width="80dp" android:layout_height="wrap_content"
                    android:hint="—°C" android:textColor="@color/lab_text" android:textColorHint="@color/lab_text_dim"
                    android:textSize="12sp" android:fontFamily="monospace" android:gravity="end"
                    android:inputType="numberDecimal" android:background="@null" android:importantForAutofill="no"
                    android:imeOptions="actionDone" android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- SC row with temp field -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                <TextView android:id="@+id/tv_sc" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="@color/lab_text" android:textSize="13sp" android:fontFamily="monospace" />
                <EditText android:id="@+id/et_sc_temp" android:layout_width="80dp" android:layout_height="wrap_content"
                    android:hint="—°C" android:textColor="@color/lab_text" android:textColorHint="@color/lab_text_dim"
                    android:textSize="12sp" android:fontFamily="monospace" android:gravity="end"
                    android:inputType="numberDecimal" android:background="@null" android:importantForAutofill="no"
                    android:imeOptions="actionDone" android:paddingVertical="4dp" />
            </LinearLayout>

            <TextView android:id="@+id/tv_cooling" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/lab_text" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/tv_end" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/lab_text" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lab_border"
                android:layout_marginVertical="12dp" />

            <TextView android:id="@+id/tv_total" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/lab_amber" android:textSize="14sp" android:textStyle="bold" android:fontFamily="monospace" />

            <!-- Derived stats: FC@, development time, DTR% -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="FC @"
                        android:textColor="@color/lab_text_muted" android:textSize="9sp" android:textStyle="bold"
                        android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_fc_from_start"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/lab_text" android:textSize="13sp" android:fontFamily="monospace"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DEV"
                        android:textColor="@color/lab_text_muted" android:textSize="9sp" android:textStyle="bold"
                        android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_dev_time"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/lab_text" android:textSize="13sp" android:fontFamily="monospace"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DTR"
                        android:textColor="@color/lab_text_muted" android:textSize="9sp" android:textStyle="bold"
                        android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_dtr"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/lab_text" android:textSize="13sp" android:fontFamily="monospace"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Bean info card ────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEAN"
                android:textColor="@color/lab_text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/et_bean_origin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Country or region (e.g. Ethiopia Yirgacheffe)"
                android:textColor="@color/lab_text"
                android:textColorHint="@color/lab_text_dim"
                android:textSize="13sp"
                android:background="@drawable/bg_search"
                android:padding="12dp"
                android:inputType="textCapWords"
                android:importantForAutofill="no"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_single_origin"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="SINGLE ORIGIN"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:gravity="center"
                    android:background="@drawable/bg_phase_pill"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_blend"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="BLEND"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:gravity="center"
                    android:background="@drawable/bg_phase_pill" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Batch card — weights + roast level ──────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BATCH"
                android:textColor="@color/lab_text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:layout_marginBottom="12dp" />

            <!-- Green → roasted → loss -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="GREEN (g)"
                        android:textColor="@color/lab_text_muted" android:textSize="9sp"
                        android:textStyle="bold" android:letterSpacing="0.1" />
                    <EditText android:id="@+id/et_green_weight"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="—" android:textColor="@color/lab_text" android:textColorHint="@color/lab_text_dim"
                        android:textSize="18sp" android:fontFamily="monospace"
                        android:inputType="numberDecimal" android:background="@null"
                        android:importantForAutofill="no" android:imeOptions="actionNext"
                        android:paddingVertical="4dp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textColor="@color/lab_text_dim"
                    android:textSize="16sp"
                    android:paddingHorizontal="12dp" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ROASTED (g)"
                        android:textColor="@color/lab_text_muted" android:textSize="9sp"
                        android:textStyle="bold" android:letterSpacing="0.1" />
                    <EditText android:id="@+id/et_roasted_weight"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="—" android:textColor="@color/lab_text" android:textColorHint="@color/lab_text_dim"
                        android:textSize="18sp" android:fontFamily="monospace"
                        android:inputType="numberDecimal" android:background="@null"
                        android:importantForAutofill="no" android:imeOptions="actionDone"
                        android:paddingVertical="4dp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="12dp"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LOSS"
                        android:textColor="@color/lab_text_muted" android:textSize="9sp"
                        android:textStyle="bold" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_weight_loss"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/lab_amber" android:textSize="16sp"
                        android:fontFamily="monospace" android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Roast level chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROAST LEVEL"
                android:textColor="@color/lab_text_muted"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <TextView android:id="@+id/chip_city"
                    android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    android:text="City" android:textSize="9sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_phase_pill"
                    android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/chip_city_plus"
                    android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    android:text="City+" android:textSize="9sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_phase_pill"
                    android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/chip_full_city"
                    android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    android:text="Full City" android:textSize="9sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_phase_pill" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/chip_full_city_plus"
                    android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    android:text="Full City+" android:textSize="9sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_phase_pill"
                    android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/chip_vienna"
                    android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    android:text="Vienna" android:textSize="9sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_phase_pill"
                    android:layout_marginEnd="4dp" />
                <TextView android:id="@+id/chip_french"
                    android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1"
                    android:text="French" android:textSize="9sp" android:textStyle="bold"
                    android:gravity="center" android:background="@drawable/bg_phase_pill" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Feedback card — favourite + cup rating ────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/favourite_this_roast"
                        android:textColor="@color/lab_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/favourite_desc"
                        android:textColor="@color/lab_text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_favorite"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textColor="@color/lab_text_dim"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="@drawable/bg_phase_pill" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lab_border"
                android:layout_marginVertical="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rating_label"
                android:textColor="@color/lab_text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/rating_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/star_1"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="☆"
                    android:textColor="@color/lab_text_dim"
                    android:textSize="24sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/star_2"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="☆"
                    android:textColor="@color/lab_text_dim"
                    android:textSize="24sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/star_3"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="☆"
                    android:textColor="@color/lab_text_dim"
                    android:textSize="24sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/star_4"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="☆"
                    android:textColor="@color/lab_text_dim"
                    android:textSize="24sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/star_5"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="☆"
                    android:textColor="@color/lab_text_dim"
                    android:textSize="24sp"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Notes card — inline editable ──────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTES"
                android:textColor="@color/lab_text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/et_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:gravity="top|start"
                android:hint="@string/notes_hint"
                android:textColorHint="@color/lab_text_dim"
                android:textColor="@color/lab_text"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:background="@drawable/bg_search"
                android:padding="14dp"
                android:inputType="textMultiLine|textCapSentences"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btn_save_notes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/save"
                android:textColor="@color/lab_background"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"
                android:layout_marginTop="12dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
