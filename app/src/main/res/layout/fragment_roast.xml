<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lab_background"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="24dp">

        <!-- ── Header: brand + crumb ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Roast"
                    android:textColor="@color/lab_text"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Companion"
                    android:textColor="@color/lab_amber"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_crumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROAST · IDLE"
                android:textColor="@color/lab_text_dim"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ── Timer + phase pill ────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/phase_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_phase_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="14dp">

                <View
                    android:id="@+id/phase_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_amber_dot" />

                <TextView
                    android:id="@+id/tv_phase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phase_idle"
                    android:textColor="@color/lab_amber"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/timer_default"
                android:textSize="@dimen/timer_text_size"
                android:textColor="@color/lab_text"
                android:fontFamily="monospace"
                android:letterSpacing="-0.04" />

            <TextView
                android:id="@+id/tv_timer_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elapsed"
                android:textColor="@color/lab_text_dim"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tv_crack_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 cracks"
                android:textColor="@color/lab_text_dim"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── Reference roast card (latest favourite) ──────────────── -->
        <LinearLayout
            android:id="@+id/card_reference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reference_label"
                    android:textColor="@color/lab_text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <TextView
                    android:id="@+id/tv_reference_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/lab_amber"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_reference_targets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lab_text"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ── Mic level card ────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MIC LEVEL"
                    android:textColor="@color/lab_text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <TextView
                    android:id="@+id/tv_mic_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/lab_amber"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart_level"
                android:layout_width="match_parent"
                android:layout_height="@dimen/level_meter_height" />
        </LinearLayout>

        <!-- ── First Crack event card ────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/card_first_crack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_surface"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <View
                android:id="@+id/fc_stripe"
                android:layout_width="3dp"
                android:layout_height="44dp"
                android:background="@color/lab_border_strong"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/first_crack"
                    android:textColor="@color/lab_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fc_start"
                            android:textColor="@color/lab_text_muted"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.15" />
                        <TextView
                            android:id="@+id/tv_fc_start"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/not_detected"
                            android:textColor="@color/lab_text"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fc_end"
                            android:textColor="@color/lab_text_muted"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.15" />
                        <TextView
                            android:id="@+id/tv_fc_end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/not_detected"
                            android:textColor="@color/lab_text"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fc_duration"
                            android:textColor="@color/lab_text_muted"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.15" />
                        <TextView
                            android:id="@+id/tv_fc_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/not_detected"
                            android:textColor="@color/lab_text"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Second Crack event card ───────────────────────────────── -->
        <LinearLayout
            android:id="@+id/card_second_crack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_surface"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <View
                android:id="@+id/sc_stripe"
                android:layout_width="3dp"
                android:layout_height="44dp"
                android:background="@color/lab_border_strong"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/second_crack"
                    android:textColor="@color/lab_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sc_detected"
                        android:textColor="@color/lab_text_muted"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />
                    <TextView
                        android:id="@+id/tv_sc_detected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/not_detected"
                        android:textColor="@color/lab_text"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Action buttons ────────────────────────────────────────── -->

        <!-- START: shown when idle -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/start_roast"
            android:textColor="@color/lab_background"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null"
            android:layout_marginBottom="10dp"
            android:visibility="visible" />

        <!-- PAUSE + STOP row: shown when active -->
        <LinearLayout
            android:id="@+id/btn_group_active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_pause_resume"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Pause"
                android:textColor="@color/lab_text_muted"
                android:textSize="14sp"
                android:background="@drawable/bg_btn_ghost"
                android:stateListAnimator="@null"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Stop"
                android:textColor="@color/lab_background"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- RESET: small ghost, shown when active -->
        <Button
            android:id="@+id/btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:text="Reset"
            android:textColor="@color/lab_text_dim"
            android:textSize="12sp"
            android:background="@null"
            android:stateListAnimator="@null"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_start_cooling"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/start_cooling"
            android:textColor="@color/lab_text_muted"
            android:textSize="14sp"
            android:background="@drawable/bg_btn_ghost"
            android:stateListAnimator="@null"
            android:enabled="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
