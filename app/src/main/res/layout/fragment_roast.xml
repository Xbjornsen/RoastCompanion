<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lab_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="24dp">

        <!-- ── Header: brand + crumb ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Roast"
                    android:textColor="@color/lab_text"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Companion"
                    android:textColor="@color/lab_amber"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_crumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROAST · IDLE"
                android:textColor="@color/lab_text_dim"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ── Timer + phase pill ────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/phase_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_phase_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="14dp">

                <View
                    android:id="@+id/phase_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_amber_dot" />

                <TextView
                    android:id="@+id/tv_phase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phase_idle"
                    android:textColor="@color/lab_amber"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/timer_default"
                android:textSize="@dimen/timer_text_size"
                android:textColor="@color/lab_text"
                android:fontFamily="monospace"
                android:letterSpacing="-0.04" />

            <TextView
                android:id="@+id/tv_timer_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elapsed"
                android:textColor="@color/lab_text_dim"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tv_roast_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lab_amber"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_phase_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_crack_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 cracks"
                android:textColor="@color/lab_text_dim"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_diag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lab_text_dim"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_rec_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏺ REC"
                android:textColor="@color/lab_red"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:layout_marginTop="3dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── Manual crack confirm row ────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/row_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/chip_confirm_fc_start"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="FC start"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="monospace"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_confirm_fc_end"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="FC end"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="monospace"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_confirm_sc"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="2C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="monospace"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_chip" />
        </LinearLayout>

        <!-- ── Reference roast card (latest favourite) ──────────────── -->
        <LinearLayout
            android:id="@+id/card_reference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reference_label"
                    android:textColor="@color/lab_text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <TextView
                    android:id="@+id/tv_reference_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/lab_amber"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_reference_targets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lab_text"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ── Mic level card ────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_surface"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MIC LEVEL"
                    android:textColor="@color/lab_text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <TextView
                    android:id="@+id/tv_mic_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/lab_amber"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart_level"
                android:layout_width="match_parent"
                android:layout_height="@dimen/level_meter_height" />
        </LinearLayout>

        <!-- ── First Crack event card ────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/card_first_crack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/fc_card_progress"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <View
                android:id="@+id/fc_stripe"
                android:layout_width="3dp"
                android:layout_height="44dp"
                android:background="@color/lab_border_strong"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/first_crack"
                    android:textColor="@color/lab_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fc_start"
                            android:textColor="@color/lab_text_muted"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.15" />
                        <TextView
                            android:id="@+id/tv_fc_start"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/not_detected"
                            android:textColor="@color/lab_text"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fc_end"
                            android:textColor="@color/lab_text_muted"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.15" />
                        <TextView
                            android:id="@+id/tv_fc_end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/not_detected"
                            android:textColor="@color/lab_text"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fc_duration"
                            android:textColor="@color/lab_text_muted"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.15" />
                        <TextView
                            android:id="@+id/tv_fc_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/not_detected"
                            android:textColor="@color/lab_text"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Second Crack event card ───────────────────────────────── -->
        <LinearLayout
            android:id="@+id/card_second_crack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/sc_card_progress"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <View
                android:id="@+id/sc_stripe"
                android:layout_width="3dp"
                android:layout_height="44dp"
                android:background="@color/lab_border_strong"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/second_crack"
                    android:textColor="@color/lab_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sc_detected"
                        android:textColor="@color/lab_text_muted"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />
                    <TextView
                        android:id="@+id/tv_sc_detected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/not_detected"
                        android:textColor="@color/lab_text"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ── Action buttons (pinned footer — always reachable, no scrolling) ── -->
    <LinearLayout
        android:id="@+id/action_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/lab_background"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="10dp"
        android:paddingBottom="18dp">

        <!-- Single control row: Start (idle) | Pause · Stop (active) | Reset.
             Buttons show/hide per state; gaps between visible ones are set in code. -->
        <LinearLayout
            android:id="@+id/control_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/start_roast"
                android:textColor="@color/lab_background"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"
                android:visibility="visible" />

            <Button
                android:id="@+id/btn_pause_resume"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Pause"
                android:textColor="@color/lab_text_muted"
                android:textSize="14sp"
                android:background="@drawable/bg_btn_ghost"
                android:stateListAnimator="@null"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Stop"
                android:textColor="@color/lab_background"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Reset"
                android:textColor="@color/lab_text_dim"
                android:textSize="14sp"
                android:background="@drawable/bg_btn_ghost"
                android:stateListAnimator="@null"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Second Crack alert sheet (pinned, themed, dismiss-first) ──── -->
    <LinearLayout
        android:id="@+id/sc_alert_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_card_surface"
        android:elevation="12dp"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="18dp"
        android:layout_margin="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/bg_sc_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/second_crack"
                android:textColor="@color/lab_red"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sc_alert_body"
            android:textColor="@color/lab_text_muted"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btn_sc_dismiss"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/sc_alert_dismiss"
            android:textColor="@color/lab_background"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btn_sc_cool"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/start_cooling"
            android:textColor="@color/lab_red"
            android:textSize="14sp"
            android:background="@drawable/bg_btn_ghost_danger"
            android:stateListAnimator="@null"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</FrameLayout>
