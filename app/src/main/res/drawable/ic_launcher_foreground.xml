<?xml version="1.0" encoding="utf-8"?>
<!--
    RoastCompanion adaptive icon foreground — 108dp canvas.
    Safe zone: 72dp circle centred at (54,54).

    Bean centre (54,54), rx=17, ry=21.
    Gradient: dark espresso top → caramel middle → olive green bottom.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Bean body — centred at (54,54) ────────────────────────── -->
    <!--
        rx=20, ry=24.  krx=11.0, kry=13.3
        Top (54,30) → Right (74,54) → Bottom (54,78) → Left (34,54)
    -->
    <path
        android:pathData="
            M54,30
            C65,30 74,40.7 74,54
            C74,67.3 65,78 54,78
            C43,78 34,67.3 34,54
            C34,40.7 43,30 54,30
            Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="30"
                android:endX="54"
                android:endY="78"
                android:startColor="#3A1000"
                android:centerColor="#9A6528"
                android:endColor="#7A9E3A" />
        </aapt:attr>
    </path>

    <!-- ── Bean crease — scaled to match larger bean ─────────────── -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#1A0600"
        android:strokeWidth="3"
        android:strokeAlpha="0.55"
        android:strokeLineCap="round"
        android:pathData="
            M54,32
            C48,42 60,51 54,60
            C48,69 54,76 54,76" />

</vector>
