<?xml version="1.0" encoding="utf-8"?>
<!-- Dashed framing box overlay for aiming the camera at the LED display -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <stroke
        android:width="2dp"
        android:color="@color/lab_amber"
        android:dashWidth="10dp"
        android:dashGap="6dp" />
    <solid android:color="#11FF9544" />
</shape>
